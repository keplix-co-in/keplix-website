# Copy to .env.local and fill in real values. .env.local is gitignored.

# API origin used in production builds. Leave unset in dev -- the Vite proxy
# forwards /content to the backend instead (see src/lib/api.ts).
#
# NAMING: this project calls it VITE_API_BASE_URL, but the sibling admin panel
# (kepix-admin) calls the same thing VITE_API_URL, and the Next vendor portal
# (keplix-webpage-vendors) calls it NEXT_PUBLIC_API_URL. They are three
# different names for one value: the Keplix backend origin. The divergence is
# historical, not meaningful -- do not assume a var copied from another
# project's .env will be picked up here. Read by both the browser bundle
# (import.meta.env) and vite.config.ts's proxy setup (process.env).
VITE_API_BASE_URL=https://api.keplix.co.in

# Google AdSense publisher client ID and per-slot ad unit IDs.
VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
VITE_ADSENSE_SLOT_ARTICLE_TOP=
VITE_ADSENSE_SLOT_ARTICLE_MID=
VITE_ADSENSE_SLOT_ARTICLE_END=
VITE_ADSENSE_SLOT_BLOG_GRID=
VITE_ADSENSE_SLOT_PAGE_FOOTER=

# Used server-side by api/contact.ts (Vercel serverless function) to send
# contact-form submissions via Resend. Not exposed to the browser bundle.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Keplix <noreply@keplix.co.in>
CONTACT_TO=support@keplix.co.in

# --- Local script options (optional; each has a default in code) ---------
# Neither is needed for a normal dev or production run -- they only affect the
# helper scripts in scripts/.
#
# Port for `npm run serve:dist` (scripts/serve-dist.mjs). Default 4180.
PORT=4180
# Base URL that `npm run check:hydration` probes (scripts/check-hydration.mjs).
# Default http://localhost:4173, i.e. whatever `npm run preview` is serving.
PREVIEW_URL=http://localhost:4173

# --- Provided by the platform; do NOT set these yourself ----------------
# VERCEL_ENV ('production' | 'preview' | 'development') is injected by Vercel
# and read by api/contact.ts. It is listed here only so a grep of the code
# against this file comes out clean -- setting it locally will misreport the
# environment.

# Website chatbot (api/chat.ts). These are server-side secrets: set them in Vercel, never with a VITE_ prefix.
# Either key alone works. Gemini is tried first and Groq is the fallback. Keep billing OFF on the Gemini project.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional free Cloudflare Turnstile human check for the chatbot. Set both or neither.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
