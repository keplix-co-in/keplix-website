{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "images:optimise": "node scripts/optimise-images.mjs",
    "og:generate": "node scripts/make-og-image.mjs",
    "serve:dist": "node scripts/serve-dist.mjs",
    "check:hydration": "node scripts/check-hydration.mjs",
    "check:chat": "node scripts/chat-eval.mjs",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "build:spa": "vite build",
    "test": "vitest run",
    "test:node": "node --test \"src/lib/__tests__/*.test.mjs\" \"api/__tests__/*.test.mjs\" \"scripts/__tests__/*.test.mjs\"",
    "test:all": "npm run test && npm run test:node"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "resend": "^6.18.1",
    "vite": "^6.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^5.10.2",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "gh-pages": "^6.3.0",
    "globals": "^15.9.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@vercel/node": {
      "path-to-regexp": "^6.3.0",
      "ajv": "^8.18.0"
    }
  }
}
